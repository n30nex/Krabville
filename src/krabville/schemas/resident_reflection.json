{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "reflection", "publicThought"],
        "properties": {
          "slug": {"type": "string", "maxLength": 80},
          "intention": {"type": "string", "maxLength": 240},
          "reflection": {"type": "string", "maxLength": 360},
          "publicThought": {"type": "string", "maxLength": 280}
        }
      }
    }
  }
}

