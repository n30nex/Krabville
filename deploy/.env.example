KRABVILLE_UID=1000
KRABVILLE_GID=1000
KRABVILLE_DATA_HOST=./runtime/data
KRABVILLE_CONTROL_HOST=./runtime/control
KRABVILLE_VOTER_SECRET_HOST=./deploy/secrets/voter-secret
KRABVILLE_BIND_ADDRESS=127.0.0.1
KRABVILLE_HOST_PORT=18889
KRABVILLE_PUBLIC_ORIGIN=http://127.0.0.1:18889
KRABVILLE_CODEX_BIN_HOST=/home/your-user/.codex/bin/codex
KRABVILLE_CODEX_AUTH_HOST=/home/your-user/.codex/auth.json
KRABVILLE_FAKE_PROVIDER=true
KRABVILLE_PRIMARY_MODEL=gpt-5.3-codex-spark
KRABVILLE_PRIMARY_REASONING=low
KRABVILLE_FALLBACK_MODEL=gpt-5.6-luna
KRABVILLE_FALLBACK_REASONING=low
KRABVILLE_INFERENCE_TIMEOUT=180
KRABVILLE_TICK_SECONDS=12.5
KRABVILLE_CALL_LIMIT=150
KRABVILLE_TOKEN_GUARD=1500000
KRABVILLE_SEASON_LIMIT=20
KRABVILLE_AUTO_CONTINUE=true
KRABVILLE_INTERMISSION_SECONDS=600
KRABVILLE_TICK_STALE_SECONDS=0
KRABVILLE_MAX_POPULATION=32
KRABVILLE_MAX_ADULTS=24
KRABVILLE_RELEASE_COMMIT=replace-with-the-exact-deployed-git-sha
